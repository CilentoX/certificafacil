# --- CONFIGURAÇÃO GERAL ---
APP_URL=https://certificafacil.com
API_BASE_URL=https://api.certificafacil.com/api
JWT_SECRET=sua_chave_secreta_longa_aqui

# --- BANCO DE DADOS (MySQL) ---
# Se usar o db do docker-compose, a URL será:
# mysql://root:${DB_PASSWORD}@db:3306/certificafacil
DB_PASSWORD=rootpassword

# --- MERCADO PAGO ---
MP_PUBLIC_KEY=APP_USR-xxxx
MP_ACCESS_TOKEN=APP_USR-xxxx
# MP_WEBHOOK_SECRET=opcional

# --- SMTP / E-MAIL ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu-email@exemplo.com
SMTP_PASS=sua-senha-smtp-aqui
BREVO_API_KEY=sua-chave-brevo-aqui
BREVO_SENDER_NAME=CertificaFacil
BREVO_SENDER_EMAIL=seu-email-verificado@exemplo.com

# --- FRONTEND (BUILD TIME) ---
# Esta variável deve ser passada para o serviço 'web'
VITE_API_URL=https://api.certificafacil.com/api
