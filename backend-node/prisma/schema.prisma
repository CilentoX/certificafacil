generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL") 
}

model Plan {
  id           Int       @id @default(autoincrement())
  slug         String    @unique @db.VarChar(50)
  name         String    @db.VarChar(100)
  price        Decimal   @default(0.00) @db.Decimal(10, 2)
  maxCerts     Int       @default(0) @map("max_certs")
  maxTemplates Int       @default(1) @map("max_templates")
  features     Json?
  mpPlanId     String?   @map("mp_plan_id") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  users        User[]
  @@map("plans")
}

model User {
  id            Int             @id @default(autoincrement())
  uid           String          @unique @default(uuid()) @db.Char(36)
  name          String          @db.VarChar(150)
  email         String          @unique @db.VarChar(255)
  passwordHash  String          @map("password_hash") @db.VarChar(255)
  role          UserRole        @default(user)
  planId        Int             @default(1) @map("plan_id")
  trialEndsAt   DateTime?       @map("trial_ends_at")
  avatarUrl     String?         @map("avatar_url") @db.VarChar(500)
  isActive      Boolean         @default(true) @map("is_active")
  lastLoginAt   DateTime?       @map("last_login_at")
  whatsappSession String?         @map("whatsapp_session") @db.Text
  whatsappStatus  String          @default("disconnected") @map("whatsapp_status") @db.VarChar(50)
  whatsappTemplate String?        @map("whatsapp_template") @db.Text
  emailTemplate   String?         @map("email_template") @db.Text
  smtpConfig      Json?           @map("smtp_config")
  tokenVersion    Int             @default(0) @map("token_version")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  plan          Plan            @relation(fields: [planId], references: [id])
  certificates  Certificate[]
  subscriptions Subscription[]
  activities    ActivityLog[]
  deliveryLogs  DeliveryLog[]
  projects      Project[]
  assets        Asset[]
  @@map("users")
}

enum UserRole {
  user
  editor
  admin
  superadmin
}

model Project {
  id           Int      @id @default(autoincrement())
  uid          String   @unique @default(uuid()) @db.Char(36)
  userId       Int      @map("user_id")
  name         String   @db.VarChar(255)
  templateName String?  @map("template_name") @db.VarChar(255)
  configJson   Json?    @map("config_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("projects")
}

model Certificate {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  templateName String   @map("template_name") @db.VarChar(255)
  studentName  String   @map("student_name") @db.VarChar(255)
  courseName   String?  @map("course_name") @db.VarChar(255)
  filePath     String?  @map("file_path") @db.VarChar(500)
  configJson   Json?    @map("config_json")
  validationCode String?  @unique @map("validation_code") @db.VarChar(100)
  validationUrl  String?  @map("validation_url") @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]
  @@index([userId])
  @@index([studentName])
  @@index([validationCode])
  @@index([courseName])
  @@map("certificates")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  action    String   @db.VarChar(100)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([action])
  @@map("activity_log")
}

model DeliveryLog {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  certificateId Int?     @map("certificate_id")
  channel       String   @db.VarChar(50) // "whatsapp", "email"
  recipient     String   @db.VarChar(255) // email address or phone number
  status        String   @default("pending") @db.VarChar(50) // "pending", "sent", "failed"
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificate   Certificate? @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  @@index([userId])
  @@index([channel, status])
  @@map("delivery_logs")
}

model Setting {
  settingKey   String   @id @map("setting_key") @db.VarChar(100)
  settingValue String?  @map("setting_value") @db.Text
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@map("settings")
}

model Subscription {
  id                  Int      @id @default(autoincrement())
  userId              Int      @map("user_id")
  mpSubscriptionId    String   @unique @map("mp_subscription_id") @db.VarChar(100)
  mpPlanId            String?  @map("mp_plan_id") @db.VarChar(100)
  status              String   @default("pending") @db.VarChar(30)
  payerEmail          String?  @map("payer_email") @db.VarChar(255)
  lastPaymentAt       DateTime? @map("last_payment_at")
  lastPaymentStatus   String?  @map("last_payment_status") @db.VarChar(30)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model Asset {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  filename  String   @db.VarChar(255)
  url       String   @db.VarChar(500)
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("assets")
}
